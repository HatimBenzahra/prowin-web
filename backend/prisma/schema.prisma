// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Directeur {
  id           Int        @id @default(autoincrement())
  nom          String
  prenom       String
  adresse      String?
  email        String?    @unique
  numTelephone String?
  status       UserStatus @default(ACTIF)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  managers    Manager[]
  commercials Commercial[]
  zones       Zone[]
  statistics  Statistic[]
}

model Manager {
  id            Int        @id @default(autoincrement())
  nom           String
  prenom        String
  email         String?    @unique
  numTelephone  String?
  status        UserStatus @default(ACTIF)
  winleadPlusId String?    @unique // UUID du manager côté WinLead+
  directeurId   Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  directeur        Directeur?         @relation(fields: [directeurId], references: [id])
  commercials      Commercial[]
  zones            Zone[]
  immeubles        Immeuble[]
  statistics       Statistic[]
  statusHistorique StatusHistorique[]
  rankSnapshots    RankSnapshot[]
  contratsValides  ContratValide[]
  commercialBadges CommercialBadge[]
  recordings       Recording[]
  quartiers        Quartier[]
}

model Commercial {
  id            Int        @id @default(autoincrement())
  nom           String
  prenom        String
  email         String?    @unique
  numTel        String?
  age           Int?
  status        UserStatus @default(ACTIF)
  winleadPlusId String?    @unique // UUID du commercial côté WinLead+
  managerId     Int?
  directeurId   Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  manager          Manager?           @relation(fields: [managerId], references: [id])
  directeur        Directeur?         @relation(fields: [directeurId], references: [id])
  immeubles        Immeuble[]
  statistics       Statistic[]
  statusHistorique StatusHistorique[]
  badges           CommercialBadge[]
  rankSnapshots    RankSnapshot[]
  contratsValides  ContratValide[]
  recordings       Recording[]
  quartiers        Quartier[]
}

model Zone {
  id            Int       @id @default(autoincrement())
  nom           String
  xOrigin       Float
  yOrigin       Float
  rayon         Float
  polygon       Json? // GeoJSON anneau fermé [[lng,lat],...], null = zone cercle héritée
  directeurId   Int?
  managerId     Int?
  createdById   Int? // Id de l'utilisateur créateur (null si admin ou inconnu)
  createdByType UserType? // Type du créateur (null pour un admin : pas de valeur ADMIN dans l'enum)
  createdByName String? // Snapshot du nom du créateur à la création (dénormalisé, cf. commercialNom)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  directeur        Directeur?            @relation(fields: [directeurId], references: [id])
  manager          Manager?              @relation(fields: [managerId], references: [id])
  immeubles        Immeuble[]
  statistics       Statistic[]
  zoneEnCours      ZoneEnCours[]
  historiqueZones  HistoriqueZone[]
  acquiscanTargets AcquiscanZoneTarget[]
  quartiers        Quartier[]
}

model Immeuble {
  id               Int         @id @default(autoincrement())
  adresse          String
  latitude         Float? // Coordonnée latitude pour la carte
  longitude        Float? // Coordonnée longitude pour la carte
  typeHabitat      TypeHabitat @default(IMMEUBLE)
  nbEtages         Int
  nbPortesParEtage Int
  ascenseurPresent Boolean     @default(false)
  digitalCode      String?
  commercialId     Int?
  managerId        Int?
  zoneId           Int?
  quartierId       Int?
  nbMaisonsPrevu   Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  commercial Commercial? @relation(fields: [commercialId], references: [id])
  manager    Manager?    @relation(fields: [managerId], references: [id])
  zone       Zone?       @relation(fields: [zoneId], references: [id])
  quartier   Quartier?   @relation(fields: [quartierId], references: [id])
  statistics Statistic[]
  portes     Porte[]
}

model Quartier {
  id           Int      @id @default(autoincrement())
  nom          String
  latitude     Float?
  longitude    Float?
  commercialId Int?
  managerId    Int?
  zoneId       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  commercial Commercial? @relation(fields: [commercialId], references: [id])
  manager    Manager?    @relation(fields: [managerId], references: [id])
  zone       Zone?       @relation(fields: [zoneId], references: [id])
  immeubles  Immeuble[]

  @@index([commercialId])
  @@index([managerId])
  @@index([zoneId])
  @@index([latitude, longitude])
}

enum TypeHabitat {
  IMMEUBLE
  MAISON
  PAVILLON
}

model AcquiscanAddressCoordinate {
  id             Int      @id @default(autoincrement())
  immeubleId     String   @unique @map("immeuble_id")
  dept           String
  codeInsee      String?  @map("code_insee")
  imbCode        String?  @map("imb_code")
  addrCode       String?  @map("addr_code")
  addrNumero     String?  @map("addr_numero")
  addrNomVoie    String?  @map("addr_nom_voie")
  addrNomCommune String?  @map("addr_nom_commune")
  imbX           Float?   @map("imb_x")
  imbY           Float?   @map("imb_y")
  longitude      Float?
  latitude       Float?
  importedAt     DateTime @default(now()) @map("imported_at")

  @@index([dept])
  @@index([latitude, longitude])
  @@index([dept, latitude, longitude])
  @@index([codeInsee])
  @@map("acquiscan_address_coordinates")
}

model AcquiscanZoneTarget {
  id                 Int      @id @default(autoincrement())
  zoneId             Int      @map("zone_id")
  immeubleId         String   @map("immeuble_id")
  dept               String
  codeInsee          String?  @map("code_insee")
  imbCode            String?  @map("imb_code")
  addrNumero         String?  @map("addr_numero")
  addrNomVoie        String?  @map("addr_nom_voie")
  addrNomCommune     String?  @map("addr_nom_commune")
  nbrLogements       String?  @map("nbr_logements")
  fermetureTechnique String?  @map("fermeture_technique")
  fermetureComZone   String?  @map("fermeture_com_zone")
  fermetureComAddr   String?  @map("fermeture_com_addr")
  eligFo             String?  @map("elig_fo")
  anneeFt            String?  @map("annee_ft")
  sites4g            Int?     @map("sites_4g")
  sites5g            Int?     @map("sites_5g")
  sitesTotal         Int?     @map("sites_total")
  latitude           Float
  longitude          Float
  distanceMeters     Float    @map("distance_meters")
  opportunityScore   Int      @map("opportunity_score")
  filtersSnapshot    Json?    @map("filters_snapshot")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, immeubleId])
  @@index([zoneId])
  @@index([dept])
  @@index([codeInsee])
  @@index([latitude, longitude])
  @@index([opportunityScore])
  @@map("acquiscan_zone_targets")
}

model Statistic {
  id                    Int      @id @default(autoincrement())
  commercialId          Int?
  managerId             Int?
  directeurId           Int?
  immeubleId            Int?
  zoneId                Int?
  contratsSignes        Int // Nombre de contrats signés
  immeublesVisites      Int // Nombre d'immeubles visités
  rendezVousPris        Int // Nombre de rendez-vous pris
  refus                 Int // Nombre de refus
  absents               Int      @default(0) // Nombre de portes où personne n'était présent
  argumentes            Int      @default(0) // Nombre de refus après argumentation
  nbImmeublesProspectes Int // Nombre d'immeubles prospectés
  nbPortesProspectes    Int // Nombre de portes prospectées
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  commercial Commercial? @relation(fields: [commercialId], references: [id])
  manager    Manager?    @relation(fields: [managerId], references: [id])
  directeur  Directeur?  @relation(fields: [directeurId], references: [id])
  immeuble   Immeuble?   @relation(fields: [immeubleId], references: [id])
  zone       Zone?       @relation(fields: [zoneId], references: [id])
}

model Porte {
  id              Int         @id @default(autoincrement())
  numero          String // Ex: "101", "201A"
  nomPersonnalise String? // Ex: "Porte à droite", "Appartement A"
  etage           Int
  immeubleId      Int
  statut          StatutPorte @default(NON_VISITE)
  nbRepassages    Int         @default(0)
  nbContrats      Int         @default(1) // Nombre de contrats signés pour cette porte
  rdvDate         DateTime?
  rdvTime         String? // Ex: "14:30"
  commentaire     String?
  duree           Int? // Durée de la dernière prospection chronométrée, en secondes
  derniereVisite  DateTime?
  coachingFavori  Boolean     @default(false) // porte/enregistrement/coaching marqué favori
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  immeuble          Immeuble           @relation(fields: [immeubleId], references: [id])
  statusHistorique  StatusHistorique[]
  recordingSegments RecordingSegment[]
  coachingAnalyses  CoachingAnalysis[]

  @@unique([immeubleId, numero])
}

enum StatutPorte {
  NON_VISITE
  CONTRAT_SIGNE
  REFUS
  RENDEZ_VOUS_PRIS
  ABSENT
  ARGUMENTE
  NECESSITE_REPASSAGE
}

enum UserType {
  COMMERCIAL
  MANAGER
  DIRECTEUR
}

enum UserStatus {
  ACTIF
  CONTRAT_FINIE
  UTILISATEUR_TEST
}

enum RecordingAnalysisStatus {
  PENDING
  ANALYZING
  READY
  FAILED
}

model ZoneEnCours {
  id     Int  @id @default(autoincrement())
  zoneId Int
  zone   Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  userId   Int
  userType UserType

  assignedAt DateTime @default(now())

  @@unique([userId, userType])
  @@index([zoneId])
  @@index([userId, userType])
}

model HistoriqueZone {
  id     Int  @id @default(autoincrement())
  zoneId Int
  zone   Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  userId   Int
  userType UserType

  assignedAt   DateTime
  unassignedAt DateTime

  // Snapshot des statistiques pour cette période
  totalContratsSignes      Int @default(0)
  totalImmeublesVisites    Int @default(0)
  totalRendezVousPris      Int @default(0)
  totalRefus               Int @default(0)
  totalImmeublesProspectes Int @default(0)
  totalPortesProspectes    Int @default(0)

  @@index([zoneId])
  @@index([userId, userType])
  @@index([assignedAt, unassignedAt])
}

model StatusHistorique {
  id           Int         @id @default(autoincrement())
  porteId      Int
  commercialId Int?
  managerId    Int?
  statut       StatutPorte
  commentaire  String?
  rdvDate      DateTime?
  rdvTime      String?
  duree        Int? // Durée de ce passage de prospection, en secondes
  createdAt    DateTime    @default(now())

  porte      Porte       @relation(fields: [porteId], references: [id], onDelete: Cascade)
  commercial Commercial? @relation(fields: [commercialId], references: [id])
  manager    Manager?    @relation(fields: [managerId], references: [id])

  @@index([porteId])
  @@index([commercialId])
  @@index([managerId])
  @@index([createdAt])
}

// ============================================================================
// GAMIFICATION — Offres (cache local des offres WinLead+)
// ============================================================================

model Offre {
  id              Int      @id @default(autoincrement())
  externalId      Int      @unique // ID retourné par l'API WinLead+
  nom             String
  description     String?
  categorie       String // "Téléphonie", "Assurance Santé"...
  fournisseur     String // "BLEUTEL", "Neoliane"...
  logoUrl         String?
  prixBase        Float?
  features        Json? // Array de strings depuis l'API
  popular         Boolean  @default(false)
  rating          Float?
  isActive        Boolean  @default(true)
  points          Int      @default(0) // Points attribués au commercial pour ce contrat (configuré par l'admin)
  badgeProductKey String? // Clé produit pour le moteur de badges: MOBILE, FIBRE, DEPANSSUR, ELEC_GAZ, CONCIERGERIE, MONDIAL_TV, ASSURANCE
  syncedAt        DateTime @default(now()) // Dernière synchro avec l'API WinLead+
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contratsValides ContratValide[]

  @@index([categorie])
  @@index([fournisseur])
  @@index([isActive])
  @@index([badgeProductKey])
}

// ============================================================================
// GAMIFICATION — Badge Catalogue
// ============================================================================

enum BadgeCategory {
  PROGRESSION // Paliers tous produits confondus (1, 2, 3, 5, 10, 20, 50, 100 contrats)
  PRODUIT // Paliers spécifiques par produit (Mobile, Fibre, Dépanssur, Élec/Gaz, Conciergerie, MTV, Assurance)
  PERFORMANCE // Achievements individuels (timing, streaks, conversion, formation...)
  TROPHEE // Trophées numériques trimestriels
}

model BadgeDefinition {
  id          Int           @id @default(autoincrement())
  code        String        @unique // "PROGRESSION_10_CONTRATS", "PRODUIT_TELEPHONIE"...
  nom         String // "Débutant", "Expert Téléphonie"...
  description String? // Description longue pour l'UI
  category    BadgeCategory // Catégorie du badge
  iconUrl     String? // URL icône/image du badge
  condition   Json? // Critères d'attribution {"metric":"contratsSignes","threshold":10}
  tier        Int           @default(0) // Niveau: 0=unique, 1=bronze, 2=argent, 3=or, 4=diamant
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  commercialBadges CommercialBadge[]

  @@index([category])
  @@index([isActive])
}

// ============================================================================
// GAMIFICATION — Attribution de badges aux commerciaux
// ============================================================================

enum RankPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model CommercialBadge {
  id                Int      @id @default(autoincrement())
  commercialId      Int?
  managerId         Int?
  badgeDefinitionId Int
  periodKey         String // "2026-02-25", "2026-W09", "2026-02", "2026-Q1"
  awardedAt         DateTime @default(now())
  metadata          Json? // Données contextuelles: {"score": 42, "rank": 1}

  commercial      Commercial?     @relation(fields: [commercialId], references: [id], onDelete: Cascade)
  manager         Manager?        @relation(fields: [managerId], references: [id], onDelete: Cascade)
  badgeDefinition BadgeDefinition @relation(fields: [badgeDefinitionId], references: [id], onDelete: Cascade)

  // Un commercial/manager ne peut recevoir le même badge qu'une fois par période
  @@unique([commercialId, badgeDefinitionId, periodKey])
  @@unique([managerId, badgeDefinitionId, periodKey])
  @@index([commercialId])
  @@index([managerId])
  @@index([badgeDefinitionId])
  @@index([awardedAt])
  @@index([periodKey])
}

// ============================================================================
// GAMIFICATION — Classement / Ranking
// ============================================================================

model RankSnapshot {
  id             Int        @id @default(autoincrement())
  commercialId   Int?
  managerId      Int?
  period         RankPeriod // DAILY, WEEKLY, MONTHLY, QUARTERLY, YEARLY
  periodKey      String // "2026-02-25", "2026-W09", "2026-02", "2026-Q1", "2026"
  rank           Int // Position dans le classement (1 = premier)
  points         Int        @default(0) // Points cumulés sur la période
  contratsSignes Int        @default(0) // Nombre de contrats signés sur la période
  metadata       Json? // Données supplémentaires: {"previousRank": 3, "delta": +2}
  computedAt     DateTime   @default(now())

  commercial Commercial? @relation(fields: [commercialId], references: [id], onDelete: Cascade)
  manager    Manager?    @relation(fields: [managerId], references: [id], onDelete: Cascade)

  // Un seul snapshot par commercial par type de période par clé de période
  @@unique([commercialId, period, periodKey])
  @@unique([managerId, period, periodKey])
  @@index([period, periodKey])
  @@index([commercialId])
  @@index([managerId])
  @@index([rank])
}

// ============================================================================
// GAMIFICATION — Contrats validés (cache WinLead+ /api/prospects)
// ============================================================================

model ContratValide {
  id                      Int       @id @default(autoincrement())
  externalContratId       Int       @unique // ID du contrat côté WinLead+
  externalProspectId      Int // ID du prospect côté WinLead+
  commercialWinleadPlusId String // UUID du commercial côté WinLead+ (prospect.commercialId)
  commercialId            Int? // FK vers Commercial Pro-Win (résolu via mapping)
  managerId               Int? // FK vers Manager Pro-Win (résolu via mapping)
  offreExternalId         Int? // ID offre côté WinLead+ (souscription.offreId)
  offreId                 Int? // FK vers Offre locale (résolu via externalId)
  dateValidation          DateTime // Date de validation du contrat
  dateSignature           DateTime? // Date de signature (peut être null)
  // Clés de période pré-calculées pour requêtes rapides
  periodDay               String // "2026-02-25"
  periodWeek              String // "2026-W09"
  periodMonth             String // "2026-02"
  periodQuarter           String // "2026-Q1"
  periodYear              String // "2026"
  metadata                Json? // Données supplémentaires (nom prospect, statut prospect...)
  syncedAt                DateTime  @default(now())
  createdAt               DateTime  @default(now())

  commercial Commercial? @relation(fields: [commercialId], references: [id], onDelete: SetNull)
  manager    Manager?    @relation(fields: [managerId], references: [id], onDelete: SetNull)
  offre      Offre?      @relation(fields: [offreId], references: [id], onDelete: SetNull)

  @@index([commercialId])
  @@index([managerId])
  @@index([commercialWinleadPlusId])
  @@index([offreId])
  @@index([dateValidation])
  @@index([periodDay])
  @@index([periodWeek])
  @@index([periodMonth])
  @@index([periodQuarter])
  @@index([periodYear])
}

model RecordingSegment {
  id            Int           @id @default(autoincrement())
  porteId       Int
  commercialId  Int?
  managerId     Int?
  immeubleId    Int?
  statut        StatutPorte?
  s3KeyOriginal String
  s3KeySegment  String?
  startTime     Float
  endTime       Float
  durationSec   Float
  transcription String?
  speechScore   Int?
  status        SegmentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  porte Porte @relation(fields: [porteId], references: [id], onDelete: Cascade)

  @@index([porteId])
  @@index([commercialId])
  @@index([immeubleId])
  @@index([s3KeyOriginal])
  @@index([status])
}

model Recording {
  id              Int       @id @default(autoincrement())
  s3Key           String    @unique
  roomName        String
  userType        UserType
  commercialId    Int?
  managerId       Int?
  immeubleId      Int?
  size            BigInt?
  lastModified    DateTime?
  hasConversation Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  commercial       Commercial?        @relation(fields: [commercialId], references: [id], onDelete: SetNull)
  manager          Manager?           @relation(fields: [managerId], references: [id], onDelete: SetNull)
  analysis         RecordingAnalysis?
  coachingAnalyses CoachingAnalysis[]

  @@index([lastModified])
  @@index([roomName])
  @@index([commercialId])
  @@index([managerId])
  @@index([hasConversation])
  @@index([userType, lastModified])
}

model RecordingAnalysis {
  id                Int                     @id @default(autoincrement())
  recordingId       Int                     @unique
  s3Key             String                  @unique
  status            RecordingAnalysisStatus @default(PENDING)
  score             Int?
  totalDurationSec  Float?
  speechDurationSec Float?
  analyzedAt        DateTime?
  error             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([s3Key])
}

// Version figée d'un plan de vente, dérivée d'un fichier markdown
// (frontmatter = grille de scoring). Chaque analyse coaching épingle la version
// utilisée. Une seule version active par slug. contentHash = sha256 du markdown
// source → déduplication / versioning automatique au boot.
model SalesPlanVersion {
  id          Int      @id @default(autoincrement())
  // Organisation proprietaire de la ligne. "" = aucun tenant : c'est le CRM v1, qui
  // n'en a qu'un seul et implicite. Chaine vide et non NULL, parce qu'un NULL rendrait
  // les contraintes d'unicite ci-dessous inoperantes sur ces lignes-la : en SQL, NULL
  // n'est jamais egal a NULL, donc deux doublons a tenant NULL passeraient tous les deux.
  tenantId    String   @default("")
  slug        String
  title       String
  version     Int
  // Le hash ne vaut plus comme identite globale : deux organisations peuvent importer
  // le meme plan sans que l'une herite des versions de l'autre.
  contentHash String
  criteria    Json // barème structuré parsé (steps → criteria, poids, points)
  rawMarkdown String
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  analyses CoachingAnalysis[]

  @@unique([tenantId, contentHash])
  @@unique([tenantId, slug, version])
  @@index([tenantId, slug, isActive])
}

// Fiche produit versionnée (clé = sha256 du markdown), même contrat que
// SalesPlanVersion. Porte ce que la FORMATION autorise à affirmer ; ce que dit le
// plan de vente vient de SalesPlanVersion.criteria (steps[].pitchText).
model ProductSheetVersion {
  id          Int      @id @default(autoincrement())
  // Organisation proprietaire de la ligne. "" = aucun tenant : c'est le CRM v1, qui
  // n'en a qu'un seul et implicite. Chaine vide et non NULL, parce qu'un NULL rendrait
  // les contraintes d'unicite ci-dessous inoperantes sur ces lignes-la : en SQL, NULL
  // n'est jamais egal a NULL, donc deux doublons a tenant NULL passeraient tous les deux.
  tenantId    String   @default("")
  slug        String
  label       String
  productKey  String // slug produit, ex. "depanssur" — jointure avec detectedProducts
  version     Int
  contentHash String
  facts       Json // affirmations autorisées
  identifiers Json     @default("[]") // signaux de reconnaissance de l'offre (passe 0, mapping)
  sttTerms    Json     @default("[]") // termes à orthographier juste (initial_prompt Whisper)
  forbidden   Json // affirmations sensibles + gravité
  winleadplus Json? // résolution du prix depuis la table Offre (jamais de prix en dur)
  rawMarkdown String
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([tenantId, contentHash])
  @@unique([tenantId, slug, version])
  @@index([tenantId, slug, isActive])
  @@index([tenantId, productKey, isActive])
}

// Analyse coaching d'un enregistrement : 1 audio = 1 porte = 1 analyse.
// Source = Recording.s3Key (re-transcrit via Whisper), indépendante de
// RecordingSegment. Le LLM juge les critères, le backend calcule le score.
model CoachingAnalysis {
  id                    Int              @id @default(autoincrement())
  // Appelant : renseigne depuis la CLÉ D'API, jamais depuis la requête.
  source                String   @default("prowin")
  // Organisation proprietaire de la ligne. "" = aucun tenant : c'est le CRM v1, qui
  // n'en a qu'un seul et implicite. Chaine vide et non NULL, parce qu'un NULL rendrait
  // les contraintes d'unicite ci-dessous inoperantes sur ces lignes-la : en SQL, NULL
  // n'est jamais egal a NULL, donc deux doublons a tenant NULL passeraient tous les deux.
  tenantId              String   @default("")
  // Optionnels : une app tierce n'a ni enregistrement ni porte au sens du CRM.
  recordingId           Int?
  porteId               Int?
  userId                Int?
  managerId             Int?
  // Les memes references, telles que l'appelant les nomme. Une app qui identifie ses
  // commerciaux par UUID ne peut pas remplir les colonnes entieres ci-dessus, qui sont
  // des cles etrangeres du CRM : elle depose ses propres references ici, opaques pour
  // le moteur, qui les rend telles quelles.
  externalUserRef       String?
  externalPorteRef      String?
  s3KeyOriginal         String
  statutPorte           StatutPorte? // snapshot du statut porte au moment de l'échange
  salesPlanVersionId    Int
  status                CoachingStatus   @default(PENDING)
  quality               CoachingQuality?
  score                 Float? // 0-100, calculé par le backend (source de vérité)
  subScores             Json? // score par étape
  confidence            Float?
  summary               String?
  strengths             Json?
  improvements          Json?
  recommendations       Json?
  criterionResults      Json? // détail par critère (status/preuve/reco)
  // Conformité produit (passe 2). `score` reste le score FINAL (après malus) pour
  // que tous les agrégats existants restent justes ; scoreBeforeMalus garde le brut.
  scoreBeforeMalus      Float? // moyenne pondérée des étapes, avant malus
  malus                 Float? // points retirés (valeur positive), 0 si aucune violation
  violations            Json? // violations de conformité produit (quote/sheetSays/planSays/gravité)
  detectedProducts      Json? // clés des offres PRÉSENTÉES par le commercial (passe 0)
  productMapping        Json? // trace complète de la passe 0, offres non présentées incluses
  productSheetVersions  Json? // ids des versions de fiche utilisées en passe 2 (traçabilité)
  transcript            String?
  transcriptDurationSec Float?
  error                 String?
  attempts              Int              @default(0) // file : nb de tentatives
  nextRetryAt           DateTime? // file : prochaine tentative (backoff)
  manual                Boolean          @default(false) // lancé manuellement : ignore le gating durée
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  recording        Recording?       @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  porte            Porte?           @relation(fields: [porteId], references: [id], onDelete: SetNull)
  salesPlanVersion SalesPlanVersion @relation(fields: [salesPlanVersionId], references: [id])

  // Idempotence : 1 analyse par audio × version de plan, POUR UN APPELANT DONNE. Deux
  // organisations qui analysent le meme audio contre leur propre plan sont deux
  // jugements distincts, pas un doublon.
  // Nom explicite : le nom derive par defaut depasse les 63 caracteres que Postgres
  // accepte, et se ferait tronquer differemment ici et dans la migration.
  @@unique([source, tenantId, s3KeyOriginal, salesPlanVersionId], map: "CoachingAnalysis_appelant_audio_plan_key")
  @@index([status])
  @@index([source, tenantId]) // toutes les lectures filtrent sur le couple
  @@index([externalUserRef])
  @@index([userId])
  @@index([managerId])
  @@index([porteId])
  @@index([recordingId])
}

enum CoachingStatus {
  PENDING
  TRANSCRIBING
  MAPPING // passe 0 : quelles offres ont été abordées, et par qui
  ANALYZING // passes 1 et 2 en parallèle : jugement du plan + conformité produit
  CONFORMITY // legacy : plus jamais écrit, encore porté par des lignes antérieures
  READY
  FAILED
}

// Config singleton du coaching (éditable depuis la page de gestion).
model CoachingConfig {
  id                     Int       @id @default(1)
  coachableStatuts       Json // liste des StatutPorte qui déclenchent l'analyse auto
  minAutoDurationSec     Int       @default(120) // durée min (s) d'un audio pour l'analyse auto
  // Seuils d'ÉTIQUETAGE, appliqués après coup sur les faits rendus par le module.
  minDurationSec         Int       @default(45) // en dessous : INEXPLOITABLE
  minTranscriptChars     Int       @default(400) // en dessous : INEXPLOITABLE
  lowConfidenceBelowSec  Int       @default(90) // en dessous : LOW_CONFIDENCE
  // Planif configurable de la régénération auto des synthèses.
  synthesisCronFrequency String    @default("daily") // 'daily' | 'weekly' | 'off'
  synthesisCronHour      Int       @default(3) // 0-23
  synthesisCronMinute    Int       @default(0) // 0-59
  synthesisCronWeekday   Int       @default(1) // 0=dim..6=sam (si weekly)
  synthesisCronLastRunAt DateTime? // dernière exécution du cron de synthèse
  updatedAt              DateTime  @updatedAt
}

// Synthèse globale (hors pipeline audio) : bilan LLM par commercial / manager,
// basé sur ses sessions de coaching + statuts + contrats + zone de terrain.
model CoachingSynthesis {
  id           Int            @id @default(autoincrement())
  subjectType  String // 'commercial' | 'manager'
  subjectKey   String         @unique // "commercial:12" — 1 synthèse (la + récente) par sujet
  commercialId Int?
  managerId    Int?
  status       CoachingStatus @default(PENDING) // réutilise l'enum (PENDING/ANALYZING/READY/FAILED)
  summary      String? // legacy (ancienne sortie plate) — conservé, non utilisé
  strengths    Json? // legacy
  improvements Json? // legacy
  priorities   Json? // legacy
  sections     Json? // sortie structurée : { bilan, performanceTerrain, contrats, forces, axes, planAction }
  trend        String? // 'progresse' | 'stagne' | 'regresse'
  scoreMoyen   Float? // source de vérité (calculé backend)
  nbAnalyses   Int            @default(0)
  stats        Json? // snapshot agrégé passé au LLM (traçabilité)
  error        String?
  generatedAt  DateTime?
  updatedAt    DateTime       @updatedAt
  createdAt    DateTime       @default(now())

  @@index([commercialId])
  @@index([managerId])
}

enum CoachingQuality {
  ANALYZED // échange exploitable, score fiable
  LOW_CONFIDENCE // échange court/bruité, score indicatif
  INEXPLOITABLE // audio trop court / transcript vide → pas de score
  FAILED // erreur technique
}

model GpsPosition {
  id           Int       @id @default(autoincrement())
  // deviceId reste nullable pour lecture des anciennes lignes kiosk ;
  // les positions mobiles sont désormais rattachées à un acteur polymorphe.
  deviceId     String?
  deviceName   String?
  // Acteur polymorphe (commercial OU manager), meme pattern que ZoneEnCours.
  // Nullable pour preserver les anciennes lignes kiosk (deviceId sans acteur).
  userId       Int?
  userType     UserType?
  latitude     Float
  longitude    Float
  accuracy     Float?
  batteryLevel Int?
  isOnline     Boolean   @default(true)
  recordedAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([deviceId])
  @@index([recordedAt])
  @@index([deviceId, recordedAt])
  @@index([userId, userType])
  @@index([userId, userType, recordedAt])
}

enum SegmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Token de push Expo d'un appareil, rattaché à un acteur polymorphe
// (userId/userType), même pattern que ZoneEnCours/GpsPosition (pas de table User
// unique). Un même token n'appartient qu'à un seul compte à la fois (unique).
model DeviceToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique // ExponentPushToken[...]
  userId    Int
  userType  UserType
  platform  String? // 'ios' | 'android'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, userType])
}

enum NotificationType {
  ZONE_ASSIGNED
  ZONE_UNASSIGNED
}

// Notification in-app persistée (centre de notifications). Destinataire
// polymorphe userId/userType. `data` porte le contexte (zoneId, zoneName, ...).
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  userType  UserType
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, userType, createdAt])
}
