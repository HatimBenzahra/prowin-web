# Stateless external coaching. Keep the bound API source consistent with the CRM.
COACHING_API_URL=
COACHING_API_KEY=
COACHING_SOURCE=prowin
COACHING_TENANT_ID=
COACHING_COMPUTE_TIMEOUT_MS=1800000
COACHING_CONCURRENCY=2

# Audio credentials stay in ProWin, used only to generate temporary read URLs.
AWS_REGION=eu-west-3
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Other application configuration (including ProWin DATABASE_URL) is supplied locally.

# Live WinLead+ catalog. API_URL accepts the origin or an /api base URL.
# Staging currently intentionally reads the production WinLead+ catalog.
WINLEADPLUS_API_URL=
# Server-side commercial catalog integration (x-api-key), independent of user tokens.
WINLEADPLUS_INTEGRATION_API_KEY=
# Dedicated confidential client using client_credentials in the upstream realm.
# Its service identity must also be authorized by WinLead+'s application guard.
# Do not reuse ProWin KEYCLOAK_* credentials or a human user's password.
WINLEADPLUS_TOKEN_URL=
WINLEADPLUS_CLIENT_ID=
WINLEADPLUS_CLIENT_SECRET=
